
"""Connect the PowerPC decoder to a small ARM64 code generator."""

from prototype.ppc_decoder import decode_word


def translate_word(word):
    instruction = decode_word(word)
    mnemonic = instruction["mnemonic"]

    if mnemonic == "addi":
        destination = f'x{instruction["rt"]}'
        base_number = instruction["ra"]
        immediate = instruction["immediate"]

        if not -4095 <= immediate <= 4095:
            raise ValueError("Immediate outside supported range")

        if base_number == 0:
            if immediate >= 0:
                return [f"    mov {destination}, #{immediate}"]
            return [
                f"    mov {destination}, #0",
                f"    sub {destination}, {destination}, #{-immediate}",
            ]

        base = f"x{base_number}"

        if immediate > 0:
            return [f"    add {destination}, {base}, #{immediate}"]
        if immediate < 0:
            return [f"    sub {destination}, {base}, #{-immediate}"]

        return [f"    mov {destination}, {base}"]

    if mnemonic == "add":
        if instruction["record"]:
            raise ValueError("The add record form is not supported yet")

        destination = f'x{instruction["rt"]}'
        left = f'x{instruction["ra"]}'
        right = f'x{instruction["rb"]}'

        return [f"    add {destination}, {left}, {right}"]

    raise ValueError(f"No code generator for: {mnemonic}")


def translate_bytes(data):
    if not isinstance(data, (bytes, bytearray)) or len(data) != 4:
        raise ValueError("Instruction data must contain exactly 4 bytes")

    word = int.from_bytes(data, "big")
    return translate_word(word)
